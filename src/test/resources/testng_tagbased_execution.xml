<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="Sanity Suite" parallel="tests" thread-count="2">
    <listeners>
        <listener class-name="com.javaselenium.listeners.TestListener"/>
        <listener class-name="com.javaselenium.listeners.RetryListener"/>
    </listeners>

    <test name="Chrome Test">
        <parameter name="browser" value="chrome"/>
        <groups>
            <run>
                <include name="sanity"/>
            </run>
        </groups>
        <classes>
            <class name="com.javaselenium.tests.LoginTest"/>
            <class name="com.javaselenium.tests.HomeTest"/>
            <class name="com.javaselenium.tests.PracticeTest"/>
        </classes>
    </test>
    <test name="Firfox Test">
        <parameter name="browser" value="firefox"/>
        <groups>
            <run>
                <include name="sanity"/>
            </run>
        </groups>
        <classes>
            <class name="com.javaselenium.tests.LoginTest"/>
            <class name="com.javaselenium.tests.HomeTest"/>
            <class name="com.javaselenium.tests.PracticeTest"/>
        </classes>
    </test>
</suite>